(* Mark this test as the current one being executed *)
GVL_coUnit.CurrentTestNameBeingCalled := TestName;

(* Check if combination of address for the test suite and test name already exists.
   For every test suite the name of the test case needs to be unique.
   If a test with this name already exists, don't add it to the available tests.
   Otherwise, add it to the available tests *)

FOR CounterTestSuiteAddress := 1 TO GVL_coUnit.NumberOfInitializedTestSuites BY 1 DO

    (* Look for the test suite by comparing to the one that is currently running *)
    IF GVL_coUnit.TestSuiteAddresses[CounterTestSuiteAddress] = GVL_coUnit.CurrentTestSuiteBeingCalled THEN
        GVL_coUnit.TestSuiteAddresses[CounterTestSuiteAddress]^.AddTest(TestName := TestName, IsTestOrdered := TRUE);
        GVL_coUnit.CurrentTestIsFinished := GVL_coUnit.TestSuiteAddresses[CounterTestSuiteAddress]^.IsTestFinished(TestName := TestName);

        (* Check that no previous code has set the currently running test to ignored (for example by setting the test to DISABLED *)
        IF NOT GVL_coUnit.IgnoreCurrentTest THEN
            (* If the current test is not the current in the sequence of tests, set it to ignored until it is its turn to run
               If the current test is the one supposed to be run, check whether it has finished running or not *)
            IF GVL_coUnit.TestSuiteAddresses[CounterTestSuiteAddress]^.GetTestOrderNumber(TestName := TestName) =
                GVL_coUnit.CurrentlyRunningOrderedTestInTestSuite[CounterTestSuiteAddress] THEN
                (* Check if test if finished, if so, increase the order number of this test suite to the next test *)
                IF GVL_coUnit.CurrentTestIsFinished THEN
                    GVL_coUnit.CurrentlyRunningOrderedTestInTestSuite[CounterTestSuiteAddress] :=
                        GVL_coUnit.CurrentlyRunningOrderedTestInTestSuite[CounterTestSuiteAddress] + 1;

                    (* No need to execute the test if it is already finished *)
                    TEST_ORDERED := FALSE;
                    GVL_coUnit.IgnoreCurrentTest := TRUE;
                ELSE
                    (* Continue executing test *)
                    TEST_ORDERED := TRUE;
                END_IF
            ELSE
                (* If this is not the current test that we are supposed to run, ignore it until it is its turn *)
                TEST_ORDERED := FALSE;
                GVL_coUnit.IgnoreCurrentTest := TRUE;
            END_IF

            (* This test should be ignored *)
        ELSE
            TEST_ORDERED := FALSE;
            GVL_coUnit.IgnoreCurrentTest := TRUE;
        END_IF

        RETURN;
    END_IF
END_FOR