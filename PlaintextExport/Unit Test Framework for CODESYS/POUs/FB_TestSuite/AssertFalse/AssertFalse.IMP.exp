IF NOT BeginAssertion(TestIndex => _testIndex, Ordinal => _ordinal) THEN RETURN; END_IF
_result.Passed := FALSE;
_result.ArgumentError := FALSE;
_result.ExpectedText := '';
_result.ActualText := '';
_result.DiagnosticSuffix := '';
_result.Passed := NOT Condition;
IF NOT _result.Passed THEN
	_result.ExpectedText := 'FALSE';
	_result.ActualText := BOOL_TO_STRING(Condition);
END_IF
RecordAssertionOutcome(TestIndex := _testIndex, Ordinal := _ordinal, AssertionType := E_AssertionType.Type_BOOL, Message := Message, Comparison := _result);
