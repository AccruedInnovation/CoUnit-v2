MEMCPY(destAddr := ADR(_bits), srcAddr := ADR(Value), n := SIZEOF(LREAL));
IF (_bits AND LWORD#16#7FF0000000000000) = LWORD#16#7FF0000000000000 THEN
	IF (_bits AND LWORD#16#000FFFFFFFFFFFFF) <> 0 THEN Text_LREAL := 'NaN';
	ELSIF (_bits AND LWORD#16#8000000000000000) <> 0 THEN Text_LREAL := '-Infinity';
	ELSE Text_LREAL := '+Infinity'; END_IF
ELSE
	Text_LREAL := LREAL_TO_STRING(Value);
END_IF
