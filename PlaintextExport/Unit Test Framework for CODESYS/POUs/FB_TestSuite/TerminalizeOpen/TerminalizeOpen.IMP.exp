IF State <> E_CoUnitTestState.ABORTED AND State <> E_CoUnitTestState.ERROR THEN RETURN; END_IF
FOR _i := 1 TO NumberOfTests DO
	IF TestRecords[UDINT_TO_UINT(_i)].State = E_CoUnitTestState.OPEN THEN TestRecords[UDINT_TO_UINT(_i)].State := State; END_IF
END_FOR
OrderedCursor := UINT_TO_UDINT(NumberOfOrderedTests) + 1;
