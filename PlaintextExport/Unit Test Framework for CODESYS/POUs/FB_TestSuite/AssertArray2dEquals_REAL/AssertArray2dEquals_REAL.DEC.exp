METHOD PUBLIC AssertArray2dEquals_REAL
VAR_IN_OUT
	Expecteds : ARRAY[*, *] OF REAL;
	Actuals : ARRAY[*, *] OF REAL;
END_VAR
VAR_INPUT
	Delta : REAL;
	Message : T_MaxString;
END_VAR
VAR
	_testIndex : UINT;
	_ordinal : UDINT;
	_result : ST_CoUnitComparisonResult;
	_expectedLower : ARRAY[1..2] OF DINT;
	_actualLower : ARRAY[1..2] OF DINT;
	_extent : ARRAY[1..2] OF LINT;
	_actualExtent : ARRAY[1..2] OF LINT;
	_offset : ARRAY[1..2] OF LINT;
	_shapeMatches : BOOL;
	_elementEqual : BOOL;
	_argumentError : BOOL;
END_VAR
