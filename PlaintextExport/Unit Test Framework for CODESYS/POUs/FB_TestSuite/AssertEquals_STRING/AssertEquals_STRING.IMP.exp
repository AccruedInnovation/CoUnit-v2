IF NOT BeginAssertion(TestIndex => _testIndex, Ordinal => _ordinal) THEN RETURN; END_IF
_result.Passed := FALSE;
_result.ArgumentError := FALSE;
_result.ExpectedText := '';
_result.ActualText := '';
_result.DiagnosticSuffix := '';
_result.Passed := Expected = Actual;
IF NOT _result.Passed THEN
	_result.ExpectedText := Expected;
	_result.ActualText := Actual;
END_IF
RecordAssertionOutcome(TestIndex := _testIndex, Ordinal := _ordinal, AssertionType := E_AssertionType.Type_STRING, Message := Message, Comparison := _result);
