ReadPublicCase := FALSE;
IF Index = 0 OR Index > NumberOfTests THEN RETURN; END_IF
Page.SuiteId := _suiteId;
Page.CaseId := TestRecords[Index].CaseId;
Page.RowKey := TestRecords[Index].RowKey;
Page.Tags := TestRecords[Index].Tags;
Page.Name := TestRecords[Index].CanonicalName;
Page.Selected := TestRecords[Index].Selected;
Page.Disabled := TestRecords[Index].DefinedDisabled;
Page.Started := TestRecords[Index].Started;
Page.State := TestRecords[Index].State;
Page.MaxAssertionsPerInvocation := TestRecords[Index].MaxAssertionsPerInvocation;
Page.CleanupOutcome := TestRecords[Index].CleanupOutcome;
Page.TerminationCause := TestRecords[Index].TerminationCause;
Page.LaterDetail := TestRecords[Index].LaterDetail;
Page.LaterDetailTruncated := TestRecords[Index].LaterDetailTruncated;
Page.FirstFailure := TestRecords[Index].FirstFailure;
ReadPublicCase := TRUE;
