(* Owns the final snapshot and source-compatible result projection. *)
FUNCTION_BLOCK FB_TestResults IMPLEMENTS I_TestResults
VAR
	TestSuiteResults : POINTER TO ST_TestSuiteResults;
	_snapshot : ST_CoUnitRunSnapshot;
	_buildAttempted : BOOL;
	_buildFinished : BOOL;
	_buildFailed : BOOL;
	_buildPhase : UINT;
	_buildSuite : UDINT := 1;
	_buildTest : UDINT := 1;
END_VAR
