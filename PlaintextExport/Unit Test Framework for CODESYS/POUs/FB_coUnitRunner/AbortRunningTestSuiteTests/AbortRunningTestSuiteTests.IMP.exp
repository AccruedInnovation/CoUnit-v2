IF NOT CheckViolation() THEN RETURN; END_IF
IF (RunState <> E_CoUnitRunState.RUNNING AND RunState <> E_CoUnitRunState.BETWEEN_SUITES) AND NOT (RunState = E_CoUnitRunState.IDLE AND _catalogPreparing) THEN RETURN; END_IF
RunDisposition := E_CoUnitRunDisposition.ABORTED;
_terminalizing := TRUE;
_terminalSuite := 1;
_terminalState := E_CoUnitTestState.ABORTED;
RunState := E_CoUnitRunState.FINALIZING;
ClearContext();
