IF NOT IsOwner() THEN RETURN; END_IF
(* Final snapshots are immutable, including on misuse after completion. *)
IF RunState = E_CoUnitRunState.COMPLETE OR SnapshotSealed THEN RETURN; END_IF
IF RunDisposition <> E_CoUnitRunDisposition.FRAMEWORK_ERROR THEN
	FrameworkErrorReason := Reason;
	Diagnostic(Reason := Reason);
END_IF
RunDisposition := E_CoUnitRunDisposition.FRAMEWORK_ERROR;
_terminalizing := TRUE;
_terminalSuite := 1;
_terminalState := E_CoUnitTestState.ERROR;
RunState := E_CoUnitRunState.FINALIZING;
ClearContext();
CrossTaskViolationLatch := 0;
