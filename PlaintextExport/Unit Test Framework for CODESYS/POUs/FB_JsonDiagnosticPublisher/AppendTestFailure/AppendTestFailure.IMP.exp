AppendTestFailure := FALSE;
IF NOT AppendLiteral(Value := ',"failure":{"type":') THEN RETURN; END_IF
_type := CONCAT(STR1 := 'Type_', STR2 := F_AssertionTypeToString(AssertionType := Test.FirstFailure.AssertionType));
IF NOT AppendJsonString(Value := _type) THEN RETURN; END_IF
IF NOT AppendLiteral(Value := ',"message":') THEN RETURN; END_IF
IF NOT AppendJsonString(Value := Test.FirstFailure.Message) THEN RETURN; END_IF
IF NOT AppendLiteral(Value := ',"expected":') THEN RETURN; END_IF
IF NOT AppendJsonString(Value := Test.FirstFailure.ExpectedText) THEN RETURN; END_IF
IF NOT AppendLiteral(Value := ',"actual":') THEN RETURN; END_IF
IF NOT AppendJsonString(Value := Test.FirstFailure.ActualText) THEN RETURN; END_IF
AppendTestFailure := AppendLiteral(Value := '}');
