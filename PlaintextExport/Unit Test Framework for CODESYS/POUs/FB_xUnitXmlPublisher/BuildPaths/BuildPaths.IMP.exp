_p := ADR(_path);
_s := ADR(_stage);
_b := ADR(_backup);
_ss := ADR(_suffixS);
_sb := ADR(_suffixB);
IF _p[0] = 0 THEN RETURN; END_IF
(* Only 0..244 can contain an admissible terminator. No character-count LEN. *)
FOR _length := 0 TO 244 DO
	IF _p[_length] = 0 THEN _terminated := TRUE; EXIT; END_IF
END_FOR
IF NOT _terminated THEN RETURN; END_IF
FOR _i := 0 TO _length - 1 DO
	_s[_i] := _p[_i];
	_b[_i] := _p[_i];
END_FOR
FOR _i := 0 TO 10 DO
	_s[_length + _i] := _ss[_i];
	_b[_length + _i] := _sb[_i];
END_FOR
_s[_length + 11] := 0;
_b[_length + 11] := 0;
FOR _i := 0 TO _length + 10 DO
	IF _s[_i] = 0 OR _b[_i] = 0 THEN RETURN; END_IF
END_FOR
IF _s[_length + 11] <> 0 OR _b[_length + 11] <> 0 THEN RETURN; END_IF
IF _s[_length] = 0 OR _b[_length] = 0 THEN RETURN; END_IF
_same := TRUE;
FOR _i := 0 TO _length + 10 DO
	IF _s[_i] <> _b[_i] THEN _same := FALSE; END_IF
END_FOR
BuildPaths := NOT _same;
