        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="Utf8Diagnostic" ObjectId="" qualifiedName="FB_QualificationUtf8.Utf8Diagnostic">
              <interface />
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">TEST('Utf8Diagnostic');
IF NOT IS_TEST_FINISHED('Utf8Diagnostic') THEN
	_scans := _scans + 1;
	IF _scans = 1 THEN RETURN; END_IF
	_bytes := ADR(_message);
	_bytes[0] := 65;
	FOR _i := 0 TO 123 DO
		_bytes[1 + 2 * _i] := 16#C3;
		_bytes[2 + 2 * _i] := 16#A9;
	END_FOR
	_bytes[249] := 0;
	AssertEquals_REAL(Expected := 1.0, Actual := 1.0, Delta := -1.0, Message := _message);
	TEST_FINISHED();
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD Utf8Diagnostic
</xhtml>
              </InterfaceAsPlainText>
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_QualificationUtf8 EXTENDS FB_TestSuite
VAR
	_message : T_MaxString;
	_bytes : POINTER TO BYTE;
	_i : UINT;
	_scans : UINT;
END_VAR</xhtml>
            </InterfaceAsPlainText>
