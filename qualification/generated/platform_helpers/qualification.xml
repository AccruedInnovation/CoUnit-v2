    <pous>
      <pou name="PRG_Qualification" pouType="program">
        <interface>
          <outputVars>
            <variable name="Done">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="OraclePass">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ProjectBefore">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ProjectRejected">
