TEST('LREALPositiveInfinityEqual');
IF NOT IS_TEST_FINISHED('LREALPositiveInfinityEqual') THEN
	_pa := ADR(_fLREAL4a);
	_pb := ADR(_fLREAL4b);
	_pd := ADR(_fLREAL4d);
	AssertEquals_LREAL(Expected := _pa^, Actual := _pb^, Delta := _pd^, Message := 'LREALPositiveInfinityEqual');
	TEST_FINISHED();
END_IF
