      <pou name="FB_QualificationInitialLookup" pouType="functionBlock">
        <interface>
          <localVars />
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pouinheritance" handleUnknown="implementation">
              <Inheritance>
                <Extends>FB_TestSuite</Extends>
              </Inheritance>
            </data>
          </addData>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">LookupRecovered();</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="LookupRecovered" ObjectId="" qualifiedName="FB_QualificationInitialLookup.LookupRecovered">
              <interface />
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">TEST('LookupRecovered');
IF NOT IS_TEST_FINISHED('LookupRecovered') THEN
	TEST_FINISHED();
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD LookupRecovered
</xhtml>
