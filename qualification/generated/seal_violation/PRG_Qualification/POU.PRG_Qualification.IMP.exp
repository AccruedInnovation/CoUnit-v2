SnapshotBytes := SIZEOF(ST_CoUnitRunSnapshot);
IF NOT _sealInjected THEN
	GVL_CoUnitReporting.InjectSnapshotSealViolation := TRUE;
	_sealInjected := TRUE;
END_IF
RUN();
_snapshot REF= GVL_coUnit.coUnitRunner.GetSnapshot();
IF (GVL_coUnit.coUnitRunner.GetRunState() = E_CoUnitRunState.COMPLETE) AND NOT Done THEN
	OraclePass := TRUE;
	IF NOT (_snapshot.IsValid) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 1; END_IF
	END_IF
	IF NOT (_snapshot.Disposition = E_CoUnitRunDisposition.FRAMEWORK_ERROR) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 2; END_IF
	END_IF
	IF NOT (_snapshot.SuiteCount = UINT#1) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 3; END_IF
	END_IF
	IF NOT (_snapshot.Total = UDINT#3) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 4; END_IF
	END_IF
	IF NOT (_snapshot.Passed = UDINT#1) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 5; END_IF
	END_IF
	IF NOT (_snapshot.Failed = UDINT#1) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 6; END_IF
	END_IF
	IF NOT (_snapshot.Skipped = UDINT#1) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 7; END_IF
	END_IF
	IF NOT (_snapshot.Errors = UDINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 8; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Total = UINT#3) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 9; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[1].Name = 'TerminalPass') THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 10; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[1].State = E_CoUnitTestState.PASSED) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 11; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[1].NumberOfAsserts = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 12; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].Name = 'TerminalFailure') THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 13; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].State = E_CoUnitTestState.FAILED) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 14; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].NumberOfAsserts = UINT#1) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 15; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].FirstFailure.IsSet) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 16; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].FirstFailure.AssertionType = E_AssertionType.Type_BOOL) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 17; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[2].FirstFailure.Message = 'sealed-first-failure') THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 18; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[3].Name = 'TerminalSkip') THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 19; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[3].State = E_CoUnitTestState.SKIPPED) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 20; END_IF
	END_IF
	IF NOT (_snapshot.Suites[1].Tests[3].NumberOfAsserts = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 21; END_IF
	END_IF
	Done := TRUE;
END_IF

RunDisposition := GVL_coUnit.coUnitRunner.GetDisposition();
SnapshotDisposition := _snapshot.Disposition;
SealInjectionConsumed := NOT GVL_CoUnitReporting.InjectSnapshotSealViolation;
IF Done THEN OraclePass := OraclePass AND SealInjectionConsumed AND (RunDisposition = SnapshotDisposition); END_IF
