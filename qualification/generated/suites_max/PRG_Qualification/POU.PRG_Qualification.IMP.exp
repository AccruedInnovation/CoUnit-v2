		IF FailedCheck = 0 THEN FailedCheck := 134; END_IF
	END_IF
	IF NOT (_snapshot.Suites[32].Tests[1].State = E_CoUnitTestState.PASSED) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 135; END_IF
	END_IF
	IF NOT (_snapshot.Suites[32].Tests[1].NumberOfAsserts = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 136; END_IF
	END_IF
	Done := TRUE;
END_IF

