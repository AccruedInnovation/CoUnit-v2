		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 32; END_IF
	END_IF
	IF NOT (_snapshot.Suites[25].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 33; END_IF
	END_IF
	IF NOT (_snapshot.Suites[26].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 34; END_IF
	END_IF
	IF NOT (_snapshot.Suites[27].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 35; END_IF
	END_IF
	IF NOT (_snapshot.Suites[28].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 36; END_IF
	END_IF
	IF NOT (_snapshot.Suites[29].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 37; END_IF
	END_IF
	IF NOT (_snapshot.Suites[30].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 38; END_IF
	END_IF
	IF NOT (_snapshot.Suites[31].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 39; END_IF
	END_IF
	IF NOT (_snapshot.Suites[32].Total = UINT#0) THEN
		OraclePass := FALSE;
		IF FailedCheck = 0 THEN FailedCheck := 40; END_IF
	END_IF
	Done := TRUE;
END_IF

IF Done THEN OraclePass := OraclePass AND GuardPass; END_IF
