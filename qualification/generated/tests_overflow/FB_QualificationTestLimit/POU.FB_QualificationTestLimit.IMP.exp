FOR _index := 1 TO 2049 DO
	_name := CONCAT('Test', UINT_TO_STRING(_index));
	IF _index = 2049 THEN
	ReadQualificationGuard(Count => CountBefore, OrderedCount => OrderedBefore, Cursor => CursorBefore, LastRecord => LastBefore);
	BudgetBefore := GVL_coUnit.coUnitRunner.ReadQualificationBudget();
	END_IF
	TEST(_name);
	IF _index = 2049 THEN
	ReadQualificationGuard(Count => CountAfter, OrderedCount => OrderedAfter, Cursor => CursorAfter, LastRecord => LastAfter);
	BudgetAfter := GVL_coUnit.coUnitRunner.ReadQualificationBudget();
	GuardPass := CountBefore = 2048 AND CountAfter = CountBefore AND OrderedAfter = OrderedBefore AND CursorAfter = CursorBefore AND BudgetBefore = 0 AND BudgetAfter = BudgetBefore AND LastAfter.FirstFailure.IsSet = LastBefore.FirstFailure.IsSet AND LastAfter.CanonicalName = LastBefore.CanonicalName AND LastAfter.InUse = LastBefore.InUse AND LastAfter.IsOrdered = LastBefore.IsOrdered AND LastAfter.OrderNumber = LastBefore.OrderNumber AND LastAfter.DefinedDisabled = LastBefore.DefinedDisabled AND LastAfter.InvocationOrdinal = LastBefore.InvocationOrdinal AND LastAfter.MaxAssertionsPerInvocation = LastBefore.MaxAssertionsPerInvocation AND LastAfter.HasFailure = LastBefore.HasFailure;
	END_IF
	TEST_FINISHED();
END_FOR
