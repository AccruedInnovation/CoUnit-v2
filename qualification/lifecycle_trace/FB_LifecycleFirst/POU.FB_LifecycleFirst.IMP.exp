GVL_LifecycleTrace.Visits[1] := GVL_LifecycleTrace.Visits[1] + 1;
IF GVL_LifecycleTrace.Visits[1] = 1 THEN
	IF GVL_LifecycleTrace.EventCount < 3 THEN
		GVL_LifecycleTrace.EventCount := GVL_LifecycleTrace.EventCount + 1;
		GVL_LifecycleTrace.Order[GVL_LifecycleTrace.EventCount] := 1;
	END_IF
	GVL_LifecycleTrace.EntryMs[1] := TIME_TO_UDINT(TIME());
	GVL_LifecycleTrace.EntryScan[1] := GVL_LifecycleTrace.Scan;
END_IF
TEST('First');
TEST_FINISHED();
GVL_LifecycleTrace.ExitMs[1] := TIME_TO_UDINT(TIME());
GVL_LifecycleTrace.ExitScan[1] := GVL_LifecycleTrace.Scan;
